# -----------------------------------------------------------------------------
# Expenditure Tracker — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# -----------------------------------------------------------------------------

# --- Application ----------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
WEB_PORT=3000
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000

# Base URL of the API as seen by the browser. Only `VITE_*` keys are ever
# inlined into the client bundle — never put secrets here.
VITE_API_URL=http://localhost:4000

# --- Database (PostgreSQL) -------------------------------------------------------
DATABASE_URL=postgresql://expenditure:expenditure@localhost:5432/expenditure?schema=public
DATABASE_PASSWORD=expenditure

# --- Redis ------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- JWT --------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long-please
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long-please
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=expenditure-tracker
JWT_AUDIENCE=expenditure-tracker-clients

# --- Cookies / CSRF -----------------------------------------------------------------
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
CSRF_COOKIE_NAME=x_csrf_token

# --- CORS (comma separated allow-list) ----------------------------------------------
CORS_ORIGINS=http://localhost:3000

# --- Google OAuth --------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# --- OTP (phone authentication) --------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RATE_LIMIT_PER_HOUR=5
# Development only: logs OTP codes. Must be false in production.
OTP_DEBUG_LOG=false

# --- Password hashing -------------------------------------------------------------------
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3

# --- Rate limiting ------------------------------------------------------------------------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# --- Finance defaults -----------------------------------------------------------------------
DEFAULT_CURRENCY=BDT
DEFAULT_TIMEZONE=Asia/Dhaka

# --- Uploads / misc ----------------------------------------------------------------------------
MAX_REQUEST_BODY_SIZE=100kb
LOG_LEVEL=debug
