# -----------------------------------------------------------------------------
# Expenditure Tracker — web client environment template
# Copy to `apps/web/.env` and adjust. NEVER commit `.env`.
# The backend keeps a separate `apps/api/.env`.
#
# Only `VITE_*` keys are ever inlined into the browser bundle — never put
# secrets here.
# -----------------------------------------------------------------------------

# Dev/preview server port (read by `apps/web/vite.config.ts`).
WEB_PORT=3000

# Base URL of the API as seen by the browser.
VITE_API_URL=http://localhost:4000
