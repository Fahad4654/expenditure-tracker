# -----------------------------------------------------------------------------
# Expenditure Tracker — web client environment template
# Copy to `apps/web/.env` and adjust. NEVER commit `.env`.
# The backend keeps a separate `apps/api/.env`.
#
# Only `VITE_*` keys are ever inlined into the browser bundle — never put
# secrets here.
# -----------------------------------------------------------------------------

# Dev/preview server port (read by `apps/web/vite.config.ts`).
WEB_PORT=3000

# Base URL of the API as seen by the browser.
VITE_API_URL=http://localhost:4000

# Firebase web app config — powers the "Continue with Google" button.
# Firebase console → Project settings → Your apps → Web app → SDK setup.
# While these are unset the Google button simply does not render.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
