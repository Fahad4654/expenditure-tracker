// -----------------------------------------------------------------------------
// Expenditure Tracker — initial database schema
//
// Conventions
//   * All ids are UUID v4 generated by the application layer (client-generated
//     UUIDs are required for offline sync), never auto-increment integers.
//   * Money is `Decimal(18,2)` — never `float`/`double`.
//   * `transactionDate` is a DATE column: day bucketing is done with the
//     user's timezone at query time, so storing a timestamp would only invite
//     off-by-one bugs.
//   * Soft deletes use `deletedAt`; hard deletes are reserved for GDPR-style
//     account removal.
//   * `version` is a monotonic integer bumped on every write. Together with
//     `ChangeLog` it powers last-write-wins conflict resolution for sync.
// -----------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums -------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum CategoryKind {
  SYSTEM
  USER
}

enum OtpPurpose {
  LOGIN
  REGISTER
  VERIFY_PHONE
  PASSWORD_RESET
}

enum UserTokenKind {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum SyncEntityType {
  TRANSACTION
  CATEGORY
}

enum SyncOperationKind {
  CREATE
  UPDATE
  DELETE
}

enum SyncOperationStatus {
  APPLIED
  DUPLICATE
  REJECTED
  CONFLICT
  FAILED
}

enum ChangeKind {
  UPSERT
  DELETE
}

// --- User & authentication ---------------------------------------------------

model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  email         String?  @unique
  phone         String?  @unique
  passwordHash  String?
  googleId      String?  @unique
  avatarUrl     String?
  emailVerified Boolean  @default(false)
  phoneVerified Boolean  @default(false)
  role          UserRole @default(USER)

  defaultCurrency String @default("BDT") @db.Char(3)
  timezone        String @default("Asia/Dhaka")

  // Brute-force protection
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  refreshTokens  RefreshToken[]
  otpCodes       OtpCode[]
  userTokens     UserToken[]
  categories     Category[]
  transactions   Transaction[]
  syncOperations SyncOperation[]
  devices        Device[]
  changeLogs     ChangeLog[]
  notes          Note[]
  reminders      Reminder[]

  @@index([createdAt])
}

/// An opaque refresh token. Raw tokens are never stored — only a SHA-256 hash.
/// Tokens rotate on every use and are grouped into a `familyId` so a single
/// stolen token can revoke the whole chain.
model RefreshToken {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @db.Uuid
  /// Stable "token family" — lets us revoke every rotation of a stolen chain.
  familyId      String    @db.Uuid
  /// Monotonic rotation counter inside the family.
  rotationIndex Int       @default(0)
  /// SHA-256 of the opaque refresh token. Raw tokens are never stored.
  tokenHash     String    @unique
  userAgent     String?
  ipHash        String?
  expiresAt     DateTime
  revokedAt     DateTime?
  replacedById  String?   @db.Uuid
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model OtpCode {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String?    @db.Uuid
  /// E.164 phone number the code was sent to (phone OTP).
  phone       String?
  /// Email address the code was sent to (email OTP).
  email       String?
  /// Argon2 hash of the code. Raw codes are never stored or logged.
  codeHash    String
  purpose     OtpPurpose
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, purpose, createdAt])
  @@index([email, purpose, createdAt])
  @@index([expiresAt])
}

model UserToken {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String        @db.Uuid
  tokenHash  String        @unique
  kind       UserTokenKind
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@index([expiresAt])
}

// --- Categories --------------------------------------------------------------

model Category {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// NULL for system categories (shared, read-only).
  userId        String?         @db.Uuid
  name          String
  kind          CategoryKind    @default(USER)
  icon          String?
  color         String?
  isSystem      Boolean         @default(false)
  suggestedType TransactionType @default(EXPENSE)
  /// Monotonic write counter used for last-write-wins sync (mirrors Transaction).
  version       Int             @default(1)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
  @@index([userId])
  @@index([kind])
}

// --- Transactions ------------------------------------------------------------

model Transaction {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// UUID generated by the client *before* it ever reaches the network.
  /// Stable across retries and devices — the sync idempotency anchor.
  clientId String  @db.Uuid
  /// Device that first created the row (NULL for web-originated rows).
  deviceId String?
  userId   String  @db.Uuid

  type     TransactionType
  /// NEVER a float. `Decimal(18,2)`.
  amount   Decimal         @db.Decimal(18, 2)
  /// ISO-4217. Defaults to the user's `defaultCurrency`.
  currency String          @default("BDT") @db.Char(3)

  categoryId  String  @db.Uuid
  title       String
  description String?

  /// Optional link to a private note tagged on this transaction.
  /// Clearing the note (or deleting it) sets this back to NULL.
  noteId      String? @db.Uuid

  /// DATE only — interpreted in the owner's timezone for day bucketing.
  transactionDate DateTime @db.Date

  /// Monotonic write counter used for last-write-wins conflict resolution.
  version   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  note     Note?    @relation(fields: [noteId], references: [id], onDelete: SetNull)

  /// One row per (user, clientId): replaying a CREATE is a no-op.
  @@unique([userId, clientId])
  @@index([userId, transactionDate(sort: Desc)])
  @@index([userId, categoryId, transactionDate])
  @@index([userId, type, transactionDate])
  @@index([userId, updatedAt])
  @@index([userId, noteId])
}

// --- Offline synchronisation -------------------------------------------------

model Device {
  /// Client-supplied stable device identifier (UUID stored in secure storage).
  id         String    @id
  userId     String    @db.Uuid
  name       String?
  platform   String?
  /// Opaque cursor of the last successful pull for this device.
  lastCursor String?
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Append-only record of every offline operation the server has seen.
/// `(userId, operationId)` is unique, which is what makes replay safe.
model SyncOperation {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Idempotency key generated by the client.
  operationId     String              @db.Uuid
  userId          String              @db.Uuid
  deviceId        String
  entityType      SyncEntityType
  entityId        String              @db.Uuid
  operation       SyncOperationKind
  status          SyncOperationStatus
  /// Client wall-clock time (advisory only — never trusted for LWW).
  clientTimestamp DateTime
  receivedAt      DateTime            @default(now())
  /// Original payload, kept for auditing/conflict inspection.
  payload         Json?
  /// Rejection/conflict reason. Must never contain tokens or PII secrets.
  reason          String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, operationId])
  @@index([userId, receivedAt])
  @@index([userId, entityType, entityId])
  @@index([userId, status, receivedAt])
}

/// Append-only feed of server-side changes, drained per device with a cursor.
/// The cursor is simply the monotonic `id`, so ordering is total and stable.
model ChangeLog {
  id         BigInt         @id @default(autoincrement())
  userId     String         @db.Uuid
  /// Originating device — never echoed back to the device that made the change.
  deviceId   String?
  entityType SyncEntityType
  entityId   String         @db.Uuid
  kind       ChangeKind
  /// Entity version after this change.
  version    Int
  createdAt  DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, id])
  @@index([userId, entityType, entityId])
}

// --- Notes & reminders -------------------------------------------------------

/// A private free-form note. Not part of the offline sync feed (Phase 5 covers
/// transactions/categories only) — the `version` counter is kept so sync can
/// adopt notes later without a schema change.
model Note {
  id      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId  String  @db.Uuid
  title   String
  content String? @db.Text

  /// Transactions this note is tagged on (the FK lives on Transaction).
  transactions Transaction[]

  version   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt(sort: Desc)])
}

/// A dated reminder (bill due, goal date …). `dueDate` is DATE-only and is
/// interpreted in the owner's timezone, like `Transaction.transactionDate`.
model Reminder {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String  @db.Uuid
  title  String
  details String? @db.Text

  /// DATE only — the day the reminder is due, in the owner's timezone.
  dueDate DateTime @db.Date
  /// Optional wall-clock time on that day, `HH:mm` (24-hour).
  /// `null` = a date-only reminder with no time involved.
  dueTime String?  @db.VarChar(5)
  /// Set when the user marks the reminder done; `null` = still pending.
  completedAt DateTime?

  version   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate])
  @@index([userId, completedAt])
}
